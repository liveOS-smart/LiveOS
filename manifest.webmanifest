{
  "name": "LiveOS – Mach dir dein Leben einfach.",
  "short_name": "LiveOS",
  "description": "Finanzen, Kalender, Erinnerungen, Einkaufen und Notizen an einem Ort.",
  "lang": "de-DE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0F172A",
